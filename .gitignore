# Rust
/target/
**/*.rs.bk
Cargo.lock.orig

# Generated policy artifacts
/build/generated/
*.generated.h
*.generated.swift

# Package build output/staging (the .deb builder writes here; the shipped copy
# lives under website/public/downloads/ and IS tracked)
/dist/
/build/deb/
/build/stage/
/build/stage-postinstall.sh

# Kernel build output
*.o
*.ko
*.mod
*.mod.c
*.mod.o
*.symvers
*.order
.tmp_versions/
*.sys
*.pdb
*.obj

# macOS
.DS_Store
*.xcuserstate
xcuserdata/
DerivedData/

# Editors
.vscode/
.idea/
*.swp
kernel/linux/ebpf/*.o
fuzz/corpus/
fuzz/corpus-reassembly/
fuzz/corpus-automaton/
fuzz/fuzz-*
fuzz/fuzzer
fuzz/fuzzer-*
fuzz/crash-*
fuzz/*-corpus/

# Kernel module build artifacts (DKMS builds these fresh on the target)
*.cmd
modules.order
Module.symvers
.tmp_versions/
kernel/linux/**/*.mod
