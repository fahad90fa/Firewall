# Supabase — copy to .env.local and fill in.
# Project ref for this site: bpcylnfjdsjouqoezbpa
# Find these under Supabase Dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://bpcylnfjdsjouqoezbpa.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional: override where the Linux .deb is served from. Leave this UNSET and
# the site serves the bundled package same-origin from /downloads/<file>.deb —
# which is what makes the `download` attribute (auto-start + "Download again")
# actually save the file. If you set it, point it at the .deb asset itself on a
# host that sends Content-Disposition (not a repo/page URL); a cross-origin href
# makes the browser ignore `download` and open the link instead of saving it.
# VITE_LINUX_DOWNLOAD_URL=https://downloads.example.com/unified-firewall_0.1.0_amd64.deb
