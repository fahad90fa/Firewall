[Unit]
Description=Unified Firewall — license re-check (reverts enforcement if the key has lapsed)
Documentation=https://github.com/fahad90fa/Firewall
# Needs the network to reach the license server; binds nothing itself.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Re-validates the activated key online and caches the verdict. If the vendor
# has expired, suspended or blocked the key, this reverts `table inet ufw` so the
# machine stops enforcing — the "revert to unprotected + warn" behaviour. A
# non-zero exit is the expected signal of a lapse (or a transient network error,
# which the offline grace window absorbs), so it is not treated as a unit
# failure by the timer.
ExecStart=/usr/local/bin/ufw-nft license check
SuccessExitStatus=0 1

# --- sandbox ---------------------------------------------------------------
# Reaches the license server (via curl) and, on a lapse, reverts the nftables
# policy (CAP_NET_ADMIN). Bounded to that one capability; it shells out to curl,
# so the process-hiding and syscall-filter directives are left off.
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/unified-firewall /run/unified-firewall
ProtectHome=yes
PrivateTmp=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
UMask=0077
