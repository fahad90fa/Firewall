[Unit]
Description=Unified Firewall — live web console (ufw-nft dashboard, loopback only)
Documentation=https://github.com/fahad90fa/Firewall
# Comes up after the policy is restored so the console reads ACTIVE from the
# first paint; the network need not be online (it binds loopback), but we wait
# for it so listener/connection enumeration is meaningful.
After=network-online.target firewall-policy.service
Wants=network-online.target

[Service]
Type=simple
# The console is read-only apart from the one loopback-gated Contain action. It
# needs root to read the kernel's tables and (only for a request that arrives on
# loopback) write the contain table. It binds 127.0.0.1 — reachable only from
# this machine. To reach it from elsewhere, put it behind an SSH tunnel:
#   ssh -L 8787:127.0.0.1:8787 you@host   then open http://127.0.0.1:8787
ExecStart=/usr/local/bin/ufw-nft dashboard 127.0.0.1:8787
Restart=on-failure
RestartSec=3

# --- sandbox ---------------------------------------------------------------
# The console reads the kernel's tables and, on a loopback-gated request, writes
# the contain table (CAP_NET_ADMIN); it also surfaces kernel and journal logs by
# shelling out to dmesg (CAP_SYSLOG) and journalctl. The capability set is
# bounded to exactly those two. Because it spawns those diagnostic subprocesses,
# the process-hiding, kernel-log-blocking and syscall-filter directives that
# would break them are deliberately omitted; what remains still strips every
# escalation path a console request never needs.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYSLOG
AmbientCapabilities=CAP_NET_ADMIN CAP_SYSLOG
NoNewPrivileges=yes
ProtectSystem=strict
StateDirectory=unified-firewall
ReadWritePaths=/run/unified-firewall /var/log/unified-firewall /var/lib/unified-firewall
ProtectHome=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
